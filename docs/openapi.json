 "components": {
  "schemas": {
   "AdvanceIn": {
    "properties": {
     "to_hour": {
      "type": "integer",
      "maximum": 12.0,
      "minimum": 1.0,
      "title": "To Hour"
     }
    },
    "type": "object",
    "required": [
     "to_hour"
    ],
    "title": "AdvanceIn"
   },
   "AlertIn": {
    "properties": {
     "message": {
      "type": "string",
      "maxLength": 300,
      "minLength": 10,
      "title": "Message"
     },
     "min_probability": {
      "type": "number",
      "maximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Min Probability",
      "default": 0.5
     },
     "target_hour": {
      "type": "integer",
      "maximum": 12.0,
      "minimum": 0.0,
      "title": "Target Hour",
      "default": 6
     }
    },
    "type": "object",
    "required": [
     "message"
    ],
    "title": "AlertIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "ReportIn": {
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 500,
      "minLength": 3,
      "title": "Text"
     },
     "lat": {
      "type": "number",
      "maximum": 90.0,
      "minimum": -90.0,
      "title": "Lat"
     },
     "lon": {
      "type": "number",
      "maximum": 180.0,
      "minimum": -180.0,
      "title": "Lon"
     },
     "source": {
      "type": "string",
      "enum": [
       "911",
       "app",
       "social"
      ],
      "title": "Source",
      "default": "app"
     },
     "severity": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 5.0,
        "minimum": 1.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Severity",
      "description": "Only honoured from the 911 source, where a call-taker set it"
     }
    },
    "type": "object",
    "required": [
     "text",
     "lat",
     "lon"
    ],
    "title": "ReportIn"
   },
   "TelemetryIn": {
    "properties": {
     "lat": {
      "type": "number",
      "maximum": 90.0,
      "minimum": -90.0,
      "title": "Lat"
     },
     "lon": {
      "type": "number",
